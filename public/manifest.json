{
  "manifest_version": 3,
  "name": "Tab Audio Studio",
  "version": "0.1.0",
  "description": "Record, trim, clean up, and export audio from a browser tab.",
  "action": {
    "default_title": "Tab Audio Studio",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "tabCapture", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-audio-studio@example.com",
      "strict_min_version": "121.0"
    }
  }
}
