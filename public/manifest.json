{
  "manifest_version": 3,
  "name": "Tabloom",
  "version": "0.1.0",
  "description": "Record, trim, clean up, and export audio from a browser tab.",
  "action": {
    "default_title": "Tabloom",
    "default_popup": "popup.html",
    "default_icon": "assets/icons/full_img.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabloom@example.com",
      "strict_min_version": "121.0"
    }
  }
}
